# ============================================================
# PULUM-PULUM — Фронтенд (React + Vite + Tailwind)
# Multi-stage: сборка на Node, раздача через nginx
# Порт приложения: 3000
# ============================================================

# ---------- Стадия сборки ----------
FROM node:20-alpine AS build

WORKDIR /app

# Зависимости — отдельным слоем для кэширования
COPY package.json package-lock.json ./
RUN npm ci

# Исходный код
COPY index.html vite.config.js tsconfig.json ./
COPY src/ ./src/

# Адрес бэкенда «зашивается» в бандл на этапе сборки.
# По умолчанию: http://localhost:8000 (backend проброшен на хост)
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# ---------- Стадия раздачи ----------
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
