# ============================================================
# Пример переменных окружения для docker-compose
# Скопируйте в .env и скорректируйте под себя:  cp .env.example .env
# ============================================================

# Порт Ollama на хосте — ЗАКРЕПЛЁН за Ollama, не меняйте без необходимости
OLLAMA_PORT=11434

# Порты приложения
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Модель Ollama, используемая бэкендом
MODEL_NAME=qwen3.5:4b

# Адрес Ollama для бэкенда:
#   http://ollama:11434        — если Ollama крутится в этом же compose (по умолчанию)
#   http://host.docker.internal:11434 — если Ollama запущена НА ХОСТЕ как обычный сервис
OLLAMA_BASE_URL=http://ollama:11434

# Адрес API для фронтенда (подставляется при сборке образа)
VITE_API_URL=http://localhost:8000
